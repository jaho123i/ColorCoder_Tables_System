{
  "name": "colorcoder-tables",
  "version": "1.0.1",
  "description": "2D Kanban/Swimlane task board for Obsidian with Task-as-File architecture",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "kanban",
    "task-management",
    "notion"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^15.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.20.0",
    "obsidian": "latest",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
